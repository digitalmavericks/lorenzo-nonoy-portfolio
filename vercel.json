{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/assets/:path*",
      "destination": "https://raw.githubusercontent.com/digitalmavericks/lorenzo-nonoy-portfolio/main/assets/:path*",
      "permanent": false
    }
  ]
}
